<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'ı (liste; kullanıcı isteği, 19-11-2026). Hemen eklenir (siyah, otomatik yazı); renkler kalemle veya uzun basıp "Ayarlar"la (WidgetAyar). Android 11 ve öncesinde eklerken açılır. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="nl.suleymaniyecamii.namaz.WidgetAyar"
    android:description="@string/widget_liste_aciklama"
    android:initialLayout="@layout/widget_liste"
    android:minHeight="180dp"
    android:minResizeHeight="170dp"
    android:minResizeWidth="160dp"
    android:minWidth="180dp"
    android:previewLayout="@layout/widget_liste"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="3"
    android:targetCellWidth="3"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
