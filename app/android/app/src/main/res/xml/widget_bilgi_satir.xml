<?xml version="1.0" encoding="utf-8"?>
<!-- Ana ekran widget'ı (satir; kullanıcı isteği, 19-11-2026). Hemen eklenir (siyah, otomatik yazı); renkler kalemle veya uzun basıp "Ayarlar"la (WidgetAyar). Android 11 ve öncesinde eklerken açılır. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="nl.suleymaniyecamii.namaz.WidgetAyar"
    android:description="@string/widget_satir_aciklama"
    android:initialLayout="@layout/widget_satir"
    android:minHeight="50dp"
    android:minResizeHeight="40dp"
    android:minResizeWidth="200dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_satir"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
