<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Planlayici: vakit alarmı; telefon yeniden açılınca / güncellenince / saat değişince plan yeniden kurulur -->
        <receiver android:name=".VakitAlici" android:exported="false" />
        <receiver android:name=".AcilisAlici" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Sessize alma başlarken/biterken birkaç ms süren ön plan hizmeti: Android 17'de arka plandaki uygulama
             zil ayarını değiştiremez (SessizServis). Google Play'de "special use" açıklaması: app/MAGAZA.md -->
        <service
            android:name=".SessizServis"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Puts the phone on silent or vibrate at the start of each prayer time the user selected, and restores the previous ringer mode afterwards." />
        </service>

        <!-- Ana ekran widget'ları (19-11-2026; VakitWidget): her biri kendi boyutu; eklerken WidgetAyar açılır -->
        <receiver android:name=".WidgetKucuk" android:exported="false" android:label="@string/widget_kucuk_ad">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bilgi_kucuk" />
        </receiver>
        <receiver android:name=".WidgetSatir" android:exported="false" android:label="@string/widget_satir_ad">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bilgi_satir" />
        </receiver>
        <receiver android:name=".WidgetOrta" android:exported="false" android:label="@string/widget_orta_ad">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bilgi_orta" />
        </receiver>
        <receiver android:name=".WidgetListe" android:exported="false" android:label="@string/widget_liste_ad">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_bilgi_liste" />
        </receiver>
        <activity
            android:name=".WidgetAyar"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- namaz vakti bildirimleri ve durum çubuğundaki geri sayım -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- vakitler tam zamanında (kullanıcı "Alarmlar ve hatırlatıcılar"dan verir) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- telefon yeniden açılınca plan devam etsin -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- namaz vaktinde sessize alma ("Rahatsız Etmeyin" erişimi; kullanıcı verir) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- sessize alma başlarken/biterken kısa ön plan hizmeti (Android 17; SessizServis) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
</manifest>
